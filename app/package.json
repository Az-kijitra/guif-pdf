{
  "name": "guif-pdf",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A keyboard-driven PDF viewer, annotator, and page manipulation tool built with Tauri 2, Rust, and Svelte 5 for guif.",
  "imports": {
    "#lib": "./src/lib",
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "node scripts/copy-pdfjs-assets.mjs && vite dev",
    "build": "node scripts/copy-pdfjs-assets.mjs && vite build",
    "preview": "vite preview",
    "prepare": "node scripts/copy-pdfjs-assets.mjs && (svelte-kit sync || echo \"\")",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "svelte-kit sync && svelte-check && tsc --noEmit",
    "e2e": "node e2e/run.mjs",
    "e2e:build": "tauri build --debug --no-bundle",
    "docs:screenshot": "node e2e/screenshot.mjs",
    "tauri": "tauri",
    "notices": "node scripts/generate-third-party-notices.mjs",
    "release:check": "node scripts/release/versions.mjs",
    "release:build": "node scripts/release/build.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.2.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.8.69"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^4.0.1",
    "@sveltejs/kit": "^3.1.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tauri-apps/cli": "^2.2.0",
    "@types/node": "^22.10.1",
    "svelte": "^5.19.0",
    "svelte-check": "4.7.8",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
